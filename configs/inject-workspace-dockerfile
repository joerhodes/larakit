#####################################
# NOTE:
#   We should only have one Docker 'RUN' statement in this file
#   to limit the number of layers that we add.  The base Dockerfile
#   already consumes almost all of the available layes. The number
#   of layers is currently limited to 125.
#####################################
# Add extra debian/ubuntu packages
#
# Packages added
# ---------------
# tcm
# poppler-utils
#
#####################################
#
# Disable attestations during docker-in-docker image builds.  AWS Lambda will reject images with attestations.
#
#####################################
RUN apt-get install -y tcm poppler-utils ca-certificates curl gnupg lsb-release; \
    set -eux;  \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg; \
    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/ubuntu \
      $(lsb_release -cs) stable" \
      > /etc/apt/sources.list.d/docker.list; \
    apt-get update; \
    apt-get install -y docker-ce-cli; \
    # Disable default buildx attestations (prevents OCI index + attestation-manifest that Lambda can reject)
    if [ -x /usr/bin/docker ]; then \
        mkdir -p /usr/local/bin; \
        if [ -e /usr/local/bin/docker ] && [ ! -L /usr/local/bin/docker ]; then \
            mv /usr/local/bin/docker /usr/local/bin/docker.laradock.bak; \
        fi; \
        ln -sf /usr/bin/docker /usr/local/bin/docker; \
    fi; \
    # Make BUILDX_NO_DEFAULT_ATTESTATIONS available in `docker exec -it ... bash`
    echo 'export BUILDX_NO_DEFAULT_ATTESTATIONS=1' >> /etc/bash.bashrc; \
    echo 'export BUILDX_NO_DEFAULT_ATTESTATIONS=1' >> /root/.bashrc; \
    if [ -d /home/laradock ]; then \
        echo 'export BUILDX_NO_DEFAULT_ATTESTATIONS=1' >> /home/laradock/.bashrc; \
        chown laradock:laradock /home/laradock/.bashrc || true; \
    fi
