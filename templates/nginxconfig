#!/usr/bin/env bash
#
# Create the nginx config file for the current environment
#

usage() {
    printf "\nUsage: ./nginxconfig [environment]\n";
    printf "\tenvironment\t{docker|dev|stage|prod}\n\n";
    exit
}

# Look for .env to source variables from
if [ ! -r ".env" ]; then
    printf "Must run in a project with a .env file.\n"
    exit
fi

source .env

ENV=${APP_ENV:-${ENVIRONMENT}}

# If user overrides environment, use it
[ $# -eq 1 ] && {
    ENV=$1
}

# If environment is "local", make it "docker"
if [ "$ENV" == "local" ]; then
    ENV="docker"
fi

# Get domain from application's URL
[ -n "${VHOST_NAME}" ] && DOMAIN="${VHOST_NAME}" || DOMAIN=$(basename "${APP_URL}")

[ -z "${LMS_CLIENT}" ] && LMS_CLIENT=$(echo ${DOMAIN} | cut -d. -f1)

[ -z "${LMS_DSN}" ] && {
    LMS_DSN=pgsql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}
}

[ -z "${YUI_BASE}" ] && YUI_BASE=yui.fusemind.com/2.9.0

case "${ENV}" in
    "docker")
        SERVERNAME=${DOMAIN}
        SSL=false
        LMS_LIVE=FALSE
        SSL_URL=${LMS_SSL_URL:-http://${DOMAIN}/}
        NONSSL_URL=${LMS_NONSSL_URL:-http://${DOMAIN}/}
        ;;

    "dev"|"stage")
        SERVERNAME=${DOMAIN}
        SSL=true
        LMS_LIVE=FALSE
        SSL_URL=${LMS_SSL_URL:-https://${DOMAIN}/}
        NONSSL_URL=${LMS_NONSSL_URL:-http://${DOMAIN}/}
        ;;

    "prod")
        SERVERNAME=${DOMAIN}
        SSL=true
        LMS_LIVE=TRUE
        SSL_URL=${LMS_SSL_URL:-https://${DOMAIN}/}
        NONSSL_URL=${LMS_NONSSL_URL:-http://${DOMAIN}/}
        ;;

    *)
        printf "\nInvalid environment!!\n"
        usage
        ;;
esac

PROJECTDIR=$(pwd)
if [ ! -f ${PROJECTDIR}/nginxconfig ]
then
    echo "Must run nginxconfig from the project directory!"
    exit 255
fi

[ ! -d ${PROJECTDIR}/web ] && [ ! -d ${PROJECTDIR}/lms/htdocs ] && {
    echo "Unable to determine webroot!!"
    echo "Only Laravel and LF2 projects are supported."
    exit 255
}

LMS=false
[ -d ${PROJECTDIR}/lms/htdocs ] && LMS=true

PROJECT=$(basename ${PROJECTDIR})
PROJECTDIR="/var/www/${PROJECT}"

[ $LMS == true ] && WEBROOT=${PROJECTDIR}/lms/htdocs || WEBROOT=${PROJECTDIR}/web

if [ ! -f nginx.template.conf ]
then
    echo "Unable to find nginx.template.conf"
    exit 255
fi

# Replace values
awkOption="
    /%SERVERNAME%/ {
        gsub(/%SERVERNAME%/, \"${SERVERNAME}\", \$0); print; next;
    }

    /%DOMAIN%/ {
        gsub(/%DOMAIN%/, \"${DOMAIN}\", \$0); print; next;
    }

    /%PROJECTDIR%/ {
        gsub(/%PROJECTDIR%/, \"${PROJECTDIR}\", \$0); print; next;
    }

    /%PROJECT%/ {
        gsub(/%PROJECT%/, \"${PROJECT}\", \$0); print; next;
    }

    /%SSLSTUB%/ {
        gsub(/%SSLSTUB%/, \"${SSLSTUB}\", \$0); print; next;
    }

    /%WEBROOT%/ {
        gsub(/%WEBROOT%/, \"${WEBROOT}\", \$0); print; next;
    }

    /%LMSCLIENT%/ {
        gsub(/%LMSCLIENT%/, \"${LMS_CLIENT}\", \$0); print; next;
    }

    /%LMSLIVE%/ {
        gsub(/%LMSLIVE%/, \"${LMS_LIVE}\", \$0); print; next;
    }

    /%SSLURL%/ {
        gsub(/%SSLURL%/, \"${SSL_URL}\", \$0); print; next;
    }

    /%NONSSLURL%/ {
        gsub(/%NONSSLURL%/, \"${NONSSL_URL}\", \$0); print; next;
    }

    /%LMSDSN%/ {
        gsub(/%LMSDSN%/, \"${LMS_DSN}\", \$0); print; next;
    }

    /%YUIBASE%/ {
        gsub(/%YUIBASE%/, \"${YUI_BASE}\", \$0); print; next;
    }

    { print }
"

[ "$SSL" == true ] && {
    listenOption="
        /%LISTEN%/ {
            print \"    listen 443 ssl;\";
            print \"    include /etc/nginx/ssl-fusemind.conf;\";
            next;
        }
    "
} || {
    listenOption="
        /%LISTEN%/ {
            print \"    listen 80;\";
            next;
        }
    "
}

[ "$LMS" == true ] && {
    lmsOption="
        /%LMS%/ {
            next;
        }

        /%ENDLMS%/ {
            next;
        }
    "
} || {
    lmsOption="
        /%LMS%/,/%ENDLMS%/ {
            next;
        }
    "
}

awkOption="$listenOption $lmsOption $awkOption"

awk "$awkOption" nginx.template.conf > nginx.${ENV}.conf

if [ $? -ne 0 ]
then
    printf "\nThere was an error generating nginx.%s.conf\n" ${ENV}
else
    printf "nginx.%s.conf generated.\n\n" ${ENV}
    printf "Run 'larakit restart nginx' for nginx to take effect.\n"
fi
