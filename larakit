#!/usr/bin/env bash

# larakit configuration
PROJECTDIR=$(pwd)
SITESDIR="${HOME}/Sites"
LARAKIT_HOME=$(dirname "${BASH_SOURCE[0]}")
LARAKIT_LIB="${LARAKIT_HOME}/lib"
LARADOCK_HOME="${LARAKIT_HOME}/laradock"
COMPOSE_OVERRIDES="${LARAKIT_HOME}/configs/docker-compose.override.yml"
COMPOSE_ALIASES="${LARAKIT_HOME}/configs/docker-compose.aliases.yml"
COMPOSE_CONFIGS="-f docker-compose.yml -f ${COMPOSE_OVERRIDES} -f ${COMPOSE_ALIASES}"

source "${LARAKIT_LIB}/utils.bash"
source "${LARAKIT_LIB}/laradock.bash"

usage() {
    printf "\nUsage: larakit commands\n"
    printf "    help                    Show this message.\n"
    printf "    laradock install        Install Laradock.\n"
    printf "    laradock update         Pull down latest Laradock updates.\n"
    printf "    laradock config         Copy custom config files to Laradock.\n"
    printf "    depCheck                Check that local dependencies are installed.\n"
    printf "    dnsCheck                Run a test to check if containers can resolve DNS correctly.\n"
    printf "    env [reset]             [Reset and] show the values used for container building.\n"
    printf "    exec command [arg...]   Run a command in the workspace container.\n"
    printf "    run command [arg...]    Launch the workspace container and run the command.\n"
    printf "    up [service...]         Launch one or more services.\n"
    printf "    down                    Shutdown Laradock services.\n"
    printf "    ps                      Display running containers.\n"
    printf "    logs                    Display container logs.\n"
    printf "    switch version          Switch to PHP version: 7.4, 8.1, 8.2, 8.3, 8.4, 8.5.\n"
    printf "    nginx install           Copy nginx config templates to current project.\n"
    printf "    register arg...         Map one or more hostnames into Larakit containers\n"
    printf "    deregister arg...       Remove one of more hostnames from Larakit mapping\n"
    printf "    reset                   Removes all laradock images, resets environment and aliases files\n"
    printf "\n"
    printf "Additional commands and options are passed directly to docker-compose.\n"
    printf "Run 'docker-compose help' for more information.\n"
    printf "\n"
}

copyConfigs() {
    cp "${LARADOCK_HOME}"/.env.example "${LARADOCK_HOME}"/.env
    cp "${LARAKIT_HOME}"/configs/nginx-sites.conf "${LARADOCK_HOME}"/nginx/sites/projects.conf
}

updateWorkspace() {
    cwd=$(pwd)
    cd "$LARADOCK_HOME"
    git checkout -- workspace
    cd "$cwd"

    [ ! -f "${LARAKIT_HOME}"/configs/inject-workspace-dockerfile ] && return

    inject=$(cat "${LARAKIT_HOME}/configs/inject-workspace-dockerfile")

    [ -z "$inject" ] && return

    mv "${LARADOCK_HOME}"/workspace/Dockerfile "${LARADOCK_HOME}"/workspace/Dockerfile.bak

    awk "BEGIN { nearEnd=0; atStart=1; }
        /Final Touch/ { nearEnd=1; }
        {
            if (atStart && (\$0 ~ /apt-get update -yqq/)) {
                print \"    apt-get clean && \\\\\";
                print \"    apt-get autoclean && \\\\\";
                print \"    rm -rf /var/lib/apt/lists/ && \\\\\";
                print \"    apt update && \\\\\";
                atStart=0;
            }

            if (!nearEnd || (\$0 !~ /USER root/)) {
                print;
            } else {
                print;
                print \"\";
                system(\"cat '${LARAKIT_HOME}/configs/inject-workspace-dockerfile'\");
                print \"\";
            }
        }" \
        "${LARADOCK_HOME}"/workspace/Dockerfile.bak \
        >"${LARADOCK_HOME}"/workspace/Dockerfile

    rm "${LARADOCK_HOME}"/workspace/Dockerfile.bak
}

updatePhpFpm() {
    cwd=$(pwd)
    cd "$LARADOCK_HOME"
    git checkout -- php-fpm
    cd "$cwd"

    source "${LARAKIT_HOME}/configs/environment"

    version=5.6
    iniFile="${LARADOCK_HOME}/php-fpm/php${version}.ini"
    bakFile="${iniFile}.bak"
    mv "${iniFile}" "${bakFile}"
    sed 's/^short_open_tag = Off/short_open_tag = On/' "${bakFile}" > "${iniFile}"
    rm "${bakFile}"

    [ -n "${LARAVEL_MEMORY_LIMIT}" ] && {
        iniFile="${LARADOCK_HOME}/php-fpm/laravel.ini"
        bakFile="${iniFile}.bak"
        mv "${iniFile}" "${bakFile}"
        sed 's/^memory_limit = .*/memory_limit = '${LARAVEL_MEMORY_LIMIT}'/' "${bakFile}" > "${iniFile}"
        rm "${bakFile}"
    }

    [ ! -f "${LARAKIT_HOME}"/configs/inject-php-fpm-dockerfile ] && return

    inject=$(cat "${LARAKIT_HOME}/configs/inject-php-fpm-dockerfile")

    [ -z "$inject" ] && return

    mv "${LARADOCK_HOME}"/php-fpm/Dockerfile "${LARADOCK_HOME}"/php-fpm/Dockerfile.bak

    awk "BEGIN { nearEnd=0; atStart=1; }
        /Final Touch/ { nearEnd=1; }
        {
            if (atStart && (\$0 ~ /apt-get update -yqq/)) {
                print \"    apt-get clean && \\\\\";
                print \"    apt-get autoclean && \\\\\";
                print \"    rm -rf /var/lib/apt/lists/ && \\\\\";
                print \"    apt update && \\\\\";
                atStart=0;
            }

            if (!nearEnd || (\$0 !~ /USER root/)) {
                print;
            } else {
                print;
                print \"\";
                system(\"cat '${LARAKIT_HOME}/configs/inject-php-fpm-dockerfile'\");
                print \"\";
            }
        }" \
        "${LARADOCK_HOME}"/php-fpm/Dockerfile.bak \
        >"${LARADOCK_HOME}"/php-fpm/Dockerfile

    rm "${LARADOCK_HOME}"/php-fpm/Dockerfile.bak
}

installLaradock() {
    [ -d "${LARADOCK_HOME}" ] && {
        printf "Laradock appears to be installed.  Try update instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARAKIT_HOME}"

    git clone https://github.com/Laradock/laradock.git laradock

    cd "${cwd}"
}

updateLaradock() {
    [ ! -d "${LARADOCK_HOME}" ] && {
        printf "Laradock is missing.  Try install instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARADOCK_HOME}"

    git checkout -- .
    git pull

    cd "${cwd}"
}

laradockCommand() {
    subCommand=$1
    shift

    case "${subCommand}" in
    install)
        installLaradock
        copyConfigs
        updateWorkspace
        updatePhpFpm
        ;;

    update)
        updateLaradock
        copyConfigs
        updateWorkspace
        updatePhpFpm
        ;;

    updateWorkspace)
        updateWorkspace
        ;;

    updatePhpFpm)
        updatePhpFpm
        ;;

    config)
        copyConfigs
        ;;

    *)
        printf "\nUnknown larakit laradock command: %s\n" "${subCommand}"
        ;;
    esac
}

setWorkingDirectory() {
    siteslen=${#SITESDIR}
    WORKINGDIR='/var/www'
    CURRENTDIR=$(pwd)
    if [ ${SITESDIR} = "${CURRENTDIR:0:${siteslen}}" ]; then
        pos=$((${#SITESDIR} + 1))
        WORKINGDIR=${WORKINGDIR}/${CURRENTDIR:$pos}
    fi

    printf "Working directory will be %s\n" "${WORKINGDIR}"
}

runService() {
    loadSshKeys

    setWorkingDirectory

    cd "${LARADOCK_HOME}"
    docker compose ${COMPOSE_CONFIGS} run --rm -w "${WORKINGDIR}" $*
}

execService() {
    MEMORY_LIMIT=''
    [ "$1" = 'composer' ] && {
        MEMORY_LIMIT='-e COMPOSER_MEMORY_LIMIT=-1'
    }

    container=$(docker ps --filter=name='workspace' --format='{{.Names}}')
    [ -z "${container}" ] && {
        printf "\nLaradock workspace service is not running.  Use larakit run instead\n"
        exit
    }

    setWorkingDirectory

    if [ -t 0 ]; then
        ttyFlags='-it'
    else
        ttyFlags='-i'
    fi

    docker exec ${ttyFlags} -w "${WORKINGDIR}" ${MEMORY_LIMIT} ${container} $*
}

stackRunning() {
    containers=$(docker ps --filter=name='laradock' --format='{{.Names}}')
    [ -n "${containers}" ]
}

imageVersionExists() {
    version=$1

    source "${LARAKIT_HOME}"/configs/environment

    nServices=0
    nImages=0
    for service in $PHP_SERVICES; do
        nServices=$((nServices + 1))
        image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "$service" | grep "$version")
        [ -n "${image}" ] && {
            nImages=$((nImages + 1))
        }
    done

    [ $nImages -eq $nServices ]
}

imageUntagVersion() {
    version=$1

    source "${LARAKIT_HOME}"/configs/environment

    for service in $PHP_SERVICES; do
        image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "$service" | grep "$version")
        [ -n "$image" ] && docker rmi "$image"
    done
}

imageTagVersion() {
    sourceTag=$1
    newTag=$2

    source "${LARAKIT_HOME}"/configs/environment

    for service in ${PHP_SERVICES}; do
        image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "${service}" | grep "${sourceTag}")
        newImage=$(echo "${image}" | cut -d: -f1)
        [ -n "${image}" ] && docker tag "${image}" "${newImage}":"${newTag}"
    done
}

buildPhpVersion() {
    newVersion=$1

    updateEnvironment "${LARAKIT_HOME}" "$newVersion"

    source "${LARAKIT_HOME}"/configs/environment

    for line in $(cat "${LARAKIT_HOME}"/configs/environment); do
        [[ "$line" == \#* ]] && continue
        [[ "$line" != *=* ]] && continue
        [[ "$line" == *SERVICES=* ]] && continue

        variable=$(echo $line | cut -d= -f1)
        [ "$variable" != 'DEFAULT_SERVICES' ] && [ "$variable" != 'PHP_SERVICES' ] && export $variable
    done

    export DEFAULT_SERVICES PHP_SERVICES

    [[ "$PHP_SERVICES" == *workspace* ]] && updateWorkspace
    [[ "$PHP_SERVICES" == *php-fpm* ]] && updatePhpFpm

    docker compose ${COMPOSE_CONFIGS} build ${PHP_SERVICES}
}

changePhpVersion() {
    newVersion=$1

    case "${newVersion}" in
    7.4 | 8.1 | 8.2 | 8.3 | 8.4 | 8.5) ;;

    *)
        printf "Invalid PHP version!  Use of one 8.5, 8.4, 8.3, 8.2, 8.1, or 7.4\n"
        exit
        ;;
    esac

    cwd=$(pwd)
    cd "${LARADOCK_HOME}"

    stackRunning && {
        docker compose ${COMPOSE_CONFIGS} down
    }

    imageVersionExists latest && imageUntagVersion latest

    if imageVersionExists "$newVersion"; then
        imageTagVersion "$newVersion" latest
    else
        buildPhpVersion "$newVersion"
        imageTagVersion latest "$newVersion"
    fi

    cd "${cwd}"
}

copyNginxTemplates() {
    cp "${LARAKIT_HOME}"/templates/nginx.template.conf "${PROJECTDIR}"/nginx.template.conf
    cp "${LARAKIT_HOME}"/templates/nginxconfig "${PROJECTDIR}"/nginxconfig
    chmod u+x "${PROJECTDIR}"/nginxconfig

    printf "nginx.template.conf created\n"
    printf "nginxconfig created\n\n"
    printf "Run ./nginxconfig to enable your project for nginx.\n"
}

nginxCommand() {
    subCommand=$1
    shift

    case "${subCommand}" in
    install)
        copyNginxTemplates
        ;;

    *)
        printf "\nUnknown larakit nginx command: %s\n" "${subCommand}"
        ;;
    esac
}

checkDependencies() {
    checkDependency 'brew' 'Unable to find brew command!  Make sure Homebrew (https://brew.sh) is installed!' || {
        exit 1
    }

    checkDependency 'dnsmasq' 'dsnmasq is not installed!  Follow Larakit Instructions.md to complete installation!' || {
        exit 1
    }

    checkDependency 'yq' "yq is not installed!  Run 'brew install yq'." || {
        exit 1
    }

    [ ! -f "$COMPOSE_ALIASES" ] && resetAliases "${LARAKIT_HOME}"

    [ ! -f "${LARAKIT_HOME}/configs/environment" ] && resetEnvironment "${LARAKIT_HOME}"
}

dnsPreflight() {
    # Allow opt-out:
    #   LARAKIT_SKIP_PREFLIGHT=1 larakit up
    [ "${LARAKIT_SKIP_PREFLIGHT:-0}" = "1" ] && return 0

    # If Docker isn't up, skip (existing commands will fail anyway)
    docker info >/dev/null 2>&1 || return 0

    # Fast check: can a vanilla container resolve & reach common endpoints?
    # dl-cdn.alpinelinux.org matches your Vapor/Laradock apk failures.
    local test_host="dl-cdn.alpinelinux.org"
    local rc=0

    # Use busybox nslookup; keep it fast with -t timeout on docker run.
    docker run --rm -t alpine:3.23 sh -lc "nslookup ${test_host} >/dev/null 2>&1" || rc=$?

    if [ $rc -ne 0 ]; then
        printf "\n[larakit] Docker container DNS preflight FAILED.\n"
        printf "[larakit] A test container could not resolve: %s\n\n" "$test_host"

        # Print resolver info from inside a container (super helpful when debugging)
        printf "---- container /etc/resolv.conf ----\n"
        docker run --rm alpine:3.23 sh -lc "cat /etc/resolv.conf || true"
        printf "-----------------------------------\n\n"

        printf "Common cause: Docker Desktop DNS forwarding breaks when VPN status changes.\n\n"
        printf "Fix options:\n"
        printf "  1) Restart Docker Desktop (quick workaround).\n"
        printf "  2) Ensure Docker Desktop -> Settings -> Docker Engine uses dnsmasq on the host.\n"
        printf "     - Find host IP from a container:\n"
        printf "         docker run --rm alpine:3.23 sh -lc 'nslookup host.docker.internal'\n"
        printf "     - Set Docker Engine JSON:\n"
        printf "         \"dns\": [\"<reported IP>\"]\n\n"
        printf "To bypass this check:\n"
        printf "  LARAKIT_SKIP_PREFLIGHT=1 larakit <command>\n\n"

        exit 2
    fi

    printf "\nDNS preflight check successful!\n"
    return 0
}

loadProjectHostname() {
    VHOST_NAME=''

    [ -f .env ] && {
        source .env

        [ "$VHOST_NAME" = '' -a "$APP_URL" != '' ] && {
            HOSTNAME=$(echo $APP_URL | awk -F/ '{print $3}')
            TLD=$(echo $HOSTNAME | awk -F. '{print $(NF)}')

            [ "$TLD" != '' ] && {
                [ "$TLD" = 'lo' -o "$TLD" = 'test' ] && {
                    VHOST_NAME=$HOSTNAME
                }
            }
        }
    }

    echo $VHOST_NAME
}

loadAllProjectHostnames() {
    projecthosts=''
    cwd=$(pwd)

    for file in $(find "$SITESDIR" -type f -name .env); do
        [[ $file == *"larakit"* ]] && {
            continue
        }

        cd $(dirname "$file")

        hostname=$(loadProjectHostname)
        [ -n "$hostname" ] && {
            projecthosts="$projecthosts $hostname"
        }
    done

    cd "$cwd"
    echo $projecthosts
}

registerHostnames() {
    [ $# -eq 0 ] && {
        return
    }

    while [ $# -gt 0 ]; do
        addAlias "${LARAKIT_HOME}" "${1}"
        shift
    done
}

deregisterHostnames() {
    [ $# -eq 0 ] && {
        return
    }

    while [ $# -gt 0 ]; do
        removeAlias "${LARAKIT_HOME}" "${1}"
        shift
    done
}

reset() {
    cwd=$(pwd)

    cd "${LARADOCK_HOME}"
    docker compose ${COMPOSE_CONFIGS} down

    images=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep laradock)
    [ -n "$images" ] && docker rmi $images

    resetEnvironment "${LARAKIT_HOME}"

    resetAliases "${LARAKIT_HOME}"
}

# load environment overrides
[ ! -f "${LARAKIT_HOME}"/configs/environment ] && {
    updateEnvironment "${LARAKIT_HOME}"
}
source "${LARAKIT_HOME}"/configs/environment

export APP_CODE_PATH_HOST PHP_VERSION

currentworkingDir=$(pwd)
command=$1
shift

case "${command}" in
help)
    usage
    ;;

laradock)
    laradockCommand $*
    ;;

depCheck)
    checkDependencies
    ;;

dnsCheck)
    dnsPreflight
    ;;

env)
    [ "$1" = "reset" ] && resetEnvironment "${LARAKIT_HOME}"
    showEnvironment "${LARAKIT_HOME}"
    ;;

exec)
    execService $*
    ;;

run)
    runService workspace $*
    ;;

up)
    loadSshKeys
    cd "${LARADOCK_HOME}"
    SERVICES="$@"
    [ -z "${SERVICES}" ] && {
        SERVICES="${DEFAULT_SERVICES}"
    }
    docker compose ${COMPOSE_CONFIGS} up -d $SERVICES
    ;;

switch)
    changePhpVersion $*
    ;;

nginx)
    nginxCommand $*
    ;;

register)
    case $# in
    0)
        hostnames=$(loadProjectHostname)
        ;;
    *)
        hostnames="$*"
        [ "$hostnames" = 'all' ] && {
            hostnames=$(loadAllProjectHostnames)
        }
        ;;
    esac
    [ -n "$hostnames" ] && {
        registerHostnames $hostnames
    }
    ;;

deregister)
    case $# in
    0)
        hostnames=$(loadProjectHostname)
        ;;
    *)
        hostnames="$*"
        [ "$hostnames" = 'all' ] && {
            hostnames=$(loadAllProjectHostnames)
        }
        ;;
    esac
    [ -n "$hostnames" ] && {
        deregisterHostnames $hostnames
    }
    ;;

reset)
    reset
    ;;

*)
    cd "${LARADOCK_HOME}"
    docker compose ${COMPOSE_CONFIGS} $command $*
    ;;
esac

cd "${currentworkingDir}"
