#!/usr/bin/env bash

# larakit configuration
PROJECTDIR=$(pwd)
PROJECT=$(basename "${PROJECTDIR}")
SITESDIR="${HOME}/Sites"
LARAKIT_HOME=$(dirname "${BASH_SOURCE[0]}")
LARADOCK_HOME="${LARAKIT_HOME}/laradock"
COMPOSE_CONFIGS='-f docker-compose.yml -f ../configs/docker-compose.override.yml'

usage() {
    printf "\nUsage: larakit command\n"
    printf "    help                    Show this message.\n"
    printf "    laradock install        Install Laradock.\n"
    printf "    laradock update         Pull down latest Laradock updates.\n"
    printf "    laradock config         Copy custom config files to Laradock.\n"
    printf "    exec command [arg...]   Run a command in the workspace container.\n"
    printf "    run command [arg...]    Launch the workspace container and run the command.\n"
    printf "    up [service...]         Launch one or more services.\n"
    printf "    down                    Shutdown Laradock services.\n"
    printf "    ps                      Display running containers.\n"
    printf "    logs                    Display container logs.\n"
    printf "    switch version          Switch containers to specified PHP version.\n"
    printf "    nginx install           Copy nginx config templates to current project.\n"
    printf "\n"
    printf "Additional commands and options are passed directly to docker-compose.\n"
    printf "Run 'docker-compose help' for more information.\n"
    printf "\n"
}

loadSshKeys() {
    # load user's SSH keys if they have not been loaded yet
    keys=$(ssh-add -L)
    [ -n "${keys}" ] || {
        printf "\nLoading SSH Keys for SSH Agent\n"
        ssh-add -K
    }
}

copyConfigs() {
    cp "${LARADOCK_HOME}"/env-example "${LARADOCK_HOME}"/.env
    cp "${LARAKIT_HOME}"/configs/nginx-sites.conf "${LARADOCK_HOME}"/nginx/sites/projects.conf
}

installLaradock() {
    [ -d "${LARADOCK_HOME}" ] && {
        printf "Laradock appears to be installed.  Try update instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARAKIT_HOME}"

    git clone https://github.com/Laradock/laradock.git laradock

    cd "${cwd}"
}

updateLaradock() {
    [ ! -d "${LARADOCK_HOME}" ] && {
        printf "Laradock is missing.  Try install instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARADOCK_HOME}"

    git pull

    cd "${cwd}"
}

laradockCommand() {
    subCommand=$1
    shift

    case "${subCommand}" in
    install)
        installLaradock
        copyConfigs
        ;;

    update)
        updateLaradock
        copyConfigs
        ;;

    config)
        copyConfigs
        ;;

    *)
        printf "\nUnknown larakit laradock command: %s\n" ${subCommand}
        ;;
    esac
}

setWorkingDirectory() {
    siteslen=${#SITESDIR}
    WORKINGDIR='/var/www'
    CURRENTDIR=$(pwd)
    if [ ${SITESDIR} = "${CURRENTDIR:0:${siteslen}}" ]; then
        pos=$((${#SITESDIR} + 1))
        WORKINGDIR=${WORKINGDIR}/${CURRENTDIR:$pos}
    fi

    printf "Working directory will be %s\n" "${WORKINGDIR}"
}

runService() {
    loadSshKeys

    setWorkingDirectory

    cd "${LARADOCK_HOME}"
    docker-compose ${COMPOSE_CONFIGS} run --rm -w "${WORKINGDIR}" $*
}

execService() {
    MEMORY_LIMIT=''
    [ "$1" = 'composer' ] && {
        MEMORY_LIMIT='-e COMPOSER_MEMORY_LIMIT=-1'
    }

    container=$(docker ps --filter=name='laradock_workspace*' --format='{{.Names}}')
    [ -z "${container}" ] && {
        printf "\nLaradock workspace service is not running.  Use larakit run instead\n"
        exit
    }

    setWorkingDirectory

    docker exec -it -w "${WORKINGDIR}" ${MEMORY_LIMIT} ${container} $*
}

stackRunning() {
    containers=$(docker ps --filter=name='laradock_*' --format='{{.Names}}')
    [ -n "${containers}" ]
    return $?
}

updateEnvironment() {
    {
        printf "APP_CODE_PATH_HOST=\"%s\"\n" "${APP_CODE_PATH_HOST:-~/Sites}"
        printf "WORKSPACE_INSTALL_LDAP=false\n"
        printf "PHP_FPM_INSTALL_IMAGEMAGICK=false\n"
        printf "PHP_VERSION=\"%s\"\n" "${1:-7.2}"
        printf "DEFAULT_SERVICES=\"%s\"\n" "${DEFAULT_SERVICES:-nginx redis }"
        printf "PHP_SERVICES=\"%s\"\n" "${PHP_SERVICES:-workspace php-fpm}"
    } > "${LARAKIT_HOME}"/configs/environment
}

changePhpVersion() {
    newVersion=$1

    case "${newVersion}" in
    5.6 | 7.2 | 7.3 | 7.4) ;;

    *)
        printf "Invalid PHP version!  Use of one 7.2, 7.3, 7.4 or 5.6 (if desperate)\n"
        exit
        ;;
    esac

    cwd=$(pwd)
    cd ${LARADOCK_HOME}

    stackRunning && {
        docker-compose ${COMPOSE_CONFIGS} down
    }

    updateEnvironment $newVersion

    source "${LARAKIT_HOME}"/configs/environment
    export APP_CODE_PATH_HOST PHP_VERSION WORKSPACE_INSTALL_LDAP PHP_FPM_INSTALL_IMAGEMAGICK

    docker-compose ${COMPOSE_CONFIGS} build ${PHP_SERVICES}

    cd "${cwd}"
}

copyNginxTemplates() {
    cp "${LARAKIT_HOME}"/templates/nginx.template.conf "${PROJECTDIR}"/nginx.template.conf
    cp "${LARAKIT_HOME}"/templates/nginxconfig "${PROJECTDIR}"/nginxconfig
    chmod u+x "${PROJECTDIR}"/nginxconfig

    printf "nginx.template.conf created\n"
    printf "nginxconfig created\n\n"
    printf "Run ./nginxconfig to enable your project for nginx.\n"
}

nginxCommand() {
    subCommand=$1
    shift

    case "${subCommand}" in
    install)
        copyNginxTemplates
        ;;

    *)
        printf "\nUnknown larakit nginx command: %s\n" ${subCommand}
        ;;
    esac
}

# load environment overrides
[ ! -f "${LARAKIT_HOME}"/configs/environment ] && {
    updateEnvironment
}
source "${LARAKIT_HOME}"/configs/environment

export APP_CODE_PATH_HOST PHP_VERSION

currentworkingDir=$(pwd)
command=$1
shift

case "${command}" in
help)
    usage
    ;;

laradock)
    laradockCommand $*
    ;;

exec)
    execService $*
    ;;

run)
    runService workspace $*
    ;;

up)
    loadSshKeys
    cd "${LARADOCK_HOME}"
    SERVICES="$@"
    [ -z "${SERVICES}" ] && {
        SERVICES="${DEFAULT_SERVICES}"
    }
    docker-compose ${COMPOSE_CONFIGS} up -d $SERVICES
    ;;

switch)
    changePhpVersion $*
    ;;

nginx)
    nginxCommand $*
    ;;

*)
    cd "${LARADOCK_HOME}"
    docker-compose ${COMPOSE_CONFIGS} $command $*
    ;;
esac

cd "${currentworkingDir}"
