#!/usr/bin/env bash

# larakit configuration
PROJECTDIR=$(pwd)
PROJECT=$(basename "${PROJECTDIR}")
SITESDIR=$(dirname "${PROJECTDIR}")
LARAKIT_HOME=$(dirname "${BASH_SOURCE[0]}")
LARADOCK_HOME="${LARAKIT_HOME}/laradock"
COMPOSE_CONFIGS='-f docker-compose.yml -f ../configs/docker-compose.override.yml'

# load environment overrides
source "${LARAKIT_HOME}"/configs/environment

usage() {
    printf "\nUsage: larakit command\n"
    printf "\thelp\t\t\t\tShow this message.\n"
    printf "\tlaradock install\t\tInstall Laradock.\n"
    printf "\tlaradock pull\t\t\tPull down lastest Laradock updates.\n"
    printf "\tlaradock config\t\t\tCopy custom config files to laradock.\n"
    printf "\texec command [arg...]\t\tRun a command in the workspace container.\n"
    printf "\trun service command [arg...]\tLaunch the service container and run the command.\n"
    printf "\tup [service...]\t\t\tLaunch one or more services.\n"
    printf "\tdown\t\t\t\tShutdown Laradock services.\n"
    printf "\tps\t\t\t\tDisplay running containers.\n"
    printf "\tlogs\t\t\t\tDisplay container logs.\n"
    printf "\tswitch version\t\t\tSwitch containers to specified PHP version\n"
    printf "\n"
    printf "Additional commands and options are passed directly to docker-compose.\n"
    printf "Run 'docker-compose help' for more information.\n"
    printf "\n"
}

loadSshKeys() {
    # load user's SSH keys if they have not been loaded yet
    keys=$(ssh-add -L)
    [ -n "${keys}" ] || {
        printf "\nLoading SSH Keys for SSH Agent\n"
        ssh-add -K
    }
}

copyConfigs() {
    cp "${LARADOCK_HOME}"/env-example "${LARADOCK_HOME}"/.env
    cp "${LARAKIT_HOME}"/configs/nginx-sites.conf "${LARADOCK_HOME}"/nginx/sites/projects.conf
}

installLaradock() {
    [ -d "${LARADOCK_HOME}" ] && {
        printf "Laradock appears to be installed.  Try update instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARAKIT_HOME}"

    git clone https://github.com/Laradock/laradock.git laradock

    cd "${cwd}"
}

updateLaradock() {
    [ ! -d "${LARADOCK_HOME}" ] && {
        printf "Laradock is missing.  Try install instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARAKIT_HOME}"

    git pull

    cd "${cwd}"
}

laradockCommand() {
    subCommand=$1
    shift

    case "${subCommand}" in
    install)
        installLaradock
        copyConfigs
        ;;

    pull)
        updateLaradock
        copyConfigs
        ;;

    config)
        copyConfigs
        ;;

    *)
        printf "\nUnknown larakit laradock command: %s\n" ${subCommand}
        ;;
    esac
}

runService() {
    loadSshKeys

    [ "${SITESDIR}" != "${HOME}/Sites" ] && {
        printf "Working directory will be /var/www\n"
        PROJECT=''
    }

    cd "${LARADOCK_HOME}"
    docker-compose ${COMPOSE_CONFIGS} run --rm -w /var/www/"${PROJECT}" $*
}

execService() {
    [ "${SITESDIR}" != "${HOME}/Sites" ] && {
        printf "Working directory will be /var/www\n"
        PROJECT=''
    }

    MEMORY_LIMIT=''
    [ "$1" = 'composer' ] && {
        MEMORY_LIMIT='-e COMPOSER_MEMORY_LIMIT=-1'
    }

    container=$(docker ps --filter=name='laradock_workspace*' --format='{{.Names}}')
    [ -z "${container}" ] && {
        printf "\nLaradock workspace service is not running.  Use larakit run instead\n"
        exit
    }

    docker exec -it -w /var/www/"${PROJECT}" ${MEMORY_LIMIT} ${container} $*
}

stackRunning() {
    containers=$(docker ps --filter=name='laradock_*' --format='{{.Names}}')
    [ -n "${containers}" ]
    return $?
}

updateEnvironment() {
    printf "APP_CODE_PATH_HOST=\"%s\"\n" "${APP_CODE_PATH_HOST}"
    printf "PHP_VERSION=\"%s\"\n" "$1"
    printf "DEFAULT_SERVICES=\"%s\"\n" "${DEFAULT_SERVICES}"
    printf "PHP_SERVICES=\"%s\"\n" "${PHP_SERVICES}"
}

changePhpVersion() {
    newVersion=$1

    case "${newVersion}" in
    5.6 | 7.2 | 7.3 | 7.4) ;;

    *)
        printf "Invalid PHP version!  Use of one 7.2, 7.3, 7.4 or 5.6 (if desperate)\n"
        exit
        ;;
    esac

set -x
    cwd=$(pwd)
    cd ${LARADOCK_HOME}

    stackRunning && {
        docker-compose ${COMPOSE_CONFIGS} down
    }

    updateEnvironment $newVersion > "${LARAKIT_HOME}"/configs/environment

    source "${LARAKIT_HOME}"/configs/environment

    docker-compose ${COMPOSE_CONFIGS} build ${PHP_SERVICES}

    cd "${cwd}"
}

export APP_CODE_PATH_HOST PHP_VERSION

workingDir=$(pwd)
command=$1
shift

case "${command}" in
help)
    usage
    ;;

laradock)
    laradockCommand $*
    ;;

exec)
    execService $*
    ;;

run)
    runService workspace $*
    ;;

up)
    loadSshKeys
    cd "${LARADOCK_HOME}"
    SERVICES="$@"
    [ -z "${SERVICES}" ] && {
        SERVICES="${DEFAULT_SERVICES}"
    }
    docker-compose ${COMPOSE_CONFIGS} up -d $SERVICES
    ;;

switch)
    changePhpVersion $*
    ;;

*)
    cd "${LARADOCK_HOME}"
    docker-compose ${COMPOSE_CONFIGS} $command $*
    ;;
esac

cd "${workingDir}"
