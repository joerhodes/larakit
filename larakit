#!/usr/bin/env bash

# larakit configuration
PROJECTDIR=$(pwd)
SITESDIR="${HOME}/Sites"
LARAKIT_HOME=$(dirname "${BASH_SOURCE[0]}")
LARADOCK_HOME="${LARAKIT_HOME}/laradock"
COMPOSE_OVERRIDES="${LARAKIT_HOME}/configs/docker-compose.override.yml"
COMPOSE_ALIASES="${LARAKIT_HOME}/configs/docker-compose.aliases.yml"
COMPOSE_CONFIGS="-f docker-compose.yml -f ${COMPOSE_OVERRIDES} -f ${COMPOSE_ALIASES}"

usage() {
    printf "\nUsage: larakit command\n"
    printf "    help                    Show this message.\n"
    printf "    laradock install        Install Laradock.\n"
    printf "    laradock update         Pull down latest Laradock updates.\n"
    printf "    laradock config         Copy custom config files to Laradock.\n"
    printf "    env [reset]             [Reset and] show the values used for container building.\n"
    printf "    exec command [arg...]   Run a command in the workspace container.\n"
    printf "    run command [arg...]    Launch the workspace container and run the command.\n"
    printf "    up [service...]         Launch one or more services.\n"
    printf "    down                    Shutdown Laradock services.\n"
    printf "    ps                      Display running containers.\n"
    printf "    logs                    Display container logs.\n"
    printf "    switch version          Switch to PHP version: 5.6, 7.2, 7.3, 7.4, 8.0 or 8.1.\n"
    printf "    nginx install           Copy nginx config templates to current project.\n"
    printf "    register arg...         Map one or more hostnames into Larakit containers\n"
    printf "    deregister arg...       Remove one of more hostnames from Larakit mapping\n"
    printf "    reset                   Removes all laradock images, resets environment and aliases files\n"
    printf "\n"
    printf "Additional commands and options are passed directly to docker-compose.\n"
    printf "Run 'docker-compose help' for more information.\n"
    printf "\n"
}

loadSshKeys() {
    # load user's SSH keys if they have not been loaded yet
    keys=$(ssh-add -L)
    [ -n "${keys}" ] || {
        printf "\nLoading SSH Keys for SSH Agent\n"
        macOsVersion=$(sw_vers -productVersion)

        options='-K'
        [ ${macOsVersion:0:2} -ge 12 ] && options='--apple-use-keychain'

        ssh-add $options
    }
}

copyConfigs() {
    cp "${LARADOCK_HOME}"/.env.example "${LARADOCK_HOME}"/.env
    cp "${LARAKIT_HOME}"/configs/nginx-sites.conf "${LARADOCK_HOME}"/nginx/sites/projects.conf
}

updateWorkspace() {
    cwd=$(pwd)
    cd "$LARADOCK_HOME"
    git checkout -- workspace
    cd "$cwd"

    [ ! -f "${LARAKIT_HOME}"/configs/inject-workspace-dockerfile ] && return

    inject=$(cat "${LARAKIT_HOME}/configs/inject-workspace-dockerfile")

    [ -z "$inject" ] && return

    mv "${LARADOCK_HOME}"/workspace/Dockerfile "${LARADOCK_HOME}"/workspace/Dockerfile.bak

    awk "BEGIN { nearEnd=0; atStart=1; }
        /Final Touch/ { nearEnd=1; }
        {
            if (atStart && (\$0 ~ /apt-get update -yqq/)) {
                print \"    apt-get clean && \\\\\";
                print \"    apt-get autoclean && \\\\\";
                print \"    rm -rf /var/lib/apt/lists/ && \\\\\";
                print \"    apt update && \\\\\";
                atStart=0;
            }

            if (!nearEnd || (\$0 !~ /USER root/)) {
                print;
            } else {
                print;
                print \"\";
                system(\"cat '${LARAKIT_HOME}/configs/inject-workspace-dockerfile'\");
                print \"\";
            }
        }" \
        "${LARADOCK_HOME}"/workspace/Dockerfile.bak \
        >"${LARADOCK_HOME}"/workspace/Dockerfile

    rm "${LARADOCK_HOME}"/workspace/Dockerfile.bak
}

updatePhpFpm() {
    cwd=$(pwd)
    cd "$LARADOCK_HOME"
    git checkout -- php-fpm
    cd "$cwd"

    source "${LARAKIT_HOME}/configs/environment"

    version=5.6
    iniFile="${LARADOCK_HOME}/php-fpm/php${version}.ini"
    bakFile="${iniFile}.bak"
    mv "${iniFile}" "${bakFile}"
    sed 's/^short_open_tag = Off/short_open_tag = On/' "${bakFile}" > "${iniFile}"
    rm "${bakFile}"

    [ -n "${LARAVEL_MEMORY_LIMIT}" ] && {
        iniFile="${LARADOCK_HOME}/php-fpm/laravel.ini"
        bakFile="${iniFile}.bak"
        mv "${iniFile}" "${bakFile}"
        sed 's/^memory_limit = .*/memory_limit = '${LARAVEL_MEMORY_LIMIT}'/' "${bakFile}" > "${iniFile}"
        rm "${bakFile}"
    }

    [ ! -f "${LARAKIT_HOME}"/configs/inject-php-fpm-dockerfile ] && return

    inject=$(cat "${LARAKIT_HOME}/configs/inject-php-fpm-dockerfile")

    [ -z "$inject" ] && return

    mv "${LARADOCK_HOME}"/php-fpm/Dockerfile "${LARADOCK_HOME}"/php-fpm/Dockerfile.bak

    awk "BEGIN { nearEnd=0; atStart=1; }
        /Final Touch/ { nearEnd=1; }
        {
            if (atStart && (\$0 ~ /apt-get update -yqq/)) {
                print \"    apt-get clean && \\\\\";
                print \"    apt-get autoclean && \\\\\";
                print \"    rm -rf /var/lib/apt/lists/ && \\\\\";
                print \"    apt update && \\\\\";
                atStart=0;
            }

            if (!nearEnd || (\$0 !~ /USER root/)) {
                print;
            } else {
                print;
                print \"\";
                system(\"cat '${LARAKIT_HOME}/configs/inject-php-fpm-dockerfile'\");
                print \"\";
            }
        }" \
        "${LARADOCK_HOME}"/php-fpm/Dockerfile.bak \
        >"${LARADOCK_HOME}"/php-fpm/Dockerfile

    rm "${LARADOCK_HOME}"/php-fpm/Dockerfile.bak
}

installLaradock() {
    [ -d "${LARADOCK_HOME}" ] && {
        printf "Laradock appears to be installed.  Try update instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARAKIT_HOME}"

    git clone https://github.com/Laradock/laradock.git laradock

    cd "${cwd}"
}

updateLaradock() {
    [ ! -d "${LARADOCK_HOME}" ] && {
        printf "Laradock is missing.  Try install instead!\n"
        exit
    }

    cwd=$(pwd)
    cd "${LARADOCK_HOME}"

    git checkout -- .
    git pull

    cd "${cwd}"
}

laradockCommand() {
    subCommand=$1
    shift

    case "${subCommand}" in
    install)
        installLaradock
        copyConfigs
        updateWorkspace
        updatePhpFpm
        ;;

    update)
        updateLaradock
        copyConfigs
        updateWorkspace
        updatePhpFpm
        ;;

    updateWorkspace)
        updateWorkspace
        ;;

    updatePhpFpm)
        updatePhpFpm
        ;;

    config)
        copyConfigs
        ;;

    *)
        printf "\nUnknown larakit laradock command: %s\n" "${subCommand}"
        ;;
    esac
}

setWorkingDirectory() {
    siteslen=${#SITESDIR}
    WORKINGDIR='/var/www'
    CURRENTDIR=$(pwd)
    if [ ${SITESDIR} = "${CURRENTDIR:0:${siteslen}}" ]; then
        pos=$((${#SITESDIR} + 1))
        WORKINGDIR=${WORKINGDIR}/${CURRENTDIR:$pos}
    fi

    printf "Working directory will be %s\n" "${WORKINGDIR}"
}

runService() {
    loadSshKeys

    setWorkingDirectory

    cd "${LARADOCK_HOME}"
    docker compose ${COMPOSE_CONFIGS} run --rm -w "${WORKINGDIR}" $*
}

execService() {
    MEMORY_LIMIT=''
    [ "$1" = 'composer' ] && {
        MEMORY_LIMIT='-e COMPOSER_MEMORY_LIMIT=-1'
    }

    container=$(docker ps --filter=name='workspace' --format='{{.Names}}')
    [ -z "${container}" ] && {
        printf "\nLaradock workspace service is not running.  Use larakit run instead\n"
        exit
    }

    setWorkingDirectory

    docker exec -it -w "${WORKINGDIR}" ${MEMORY_LIMIT} ${container} $*
}

stackRunning() {
    containers=$(docker ps --filter=name='laradock' --format='{{.Names}}')
    [ -n "${containers}" ]
}

updateEnvironment() {
    phpVersion=$1

    envPath="${LARAKIT_HOME}"/configs/environment
    tmpPath="${LARAKIT_HOME}"/configs/environment.tmp

    mv "$envPath" "$tmpPath"
    cat "$tmpPath" | sed "s/PHP_VERSION=.*/PHP_VERSION=$phpVersion/" >$envPath

    rm "$tmpPath"
}

showEnvironment() {
    cat "${LARAKIT_HOME}"/configs/environment
}

resetEnvironment() {
    {
        cp "${LARAKIT_HOME}"/configs/environment "${LARAKIT_HOME}"/config/environment.bak

        printf "# This file overrides the features enabled in the various Laradock containers.\n"
        printf "# So changing any value or adding values requires that the containers be rebuilt.\n"
        printf "#\n"
        printf "# The following command will remove all laradock workspace containers to force a rebuild.\n"
        printf "#\n"
        printf "# docker rmi \$(docker images laradock_workspace\* --format '{{.Repository}}:{{.Tag}}')\n"
        printf "#\n"
        printf "# NOTE:\n"
        printf "#     If PHP needs more memory in the php-fpm container, \n"
        printf "#     add LARAVEL_MEMORY_LIMIT with the value needed.\n"
        printf "#\n"
        printf "APP_CODE_PATH_HOST=\"%s\"\n" "${APP_CODE_PATH_HOST:-~/Sites}"
        printf "WORKSPACE_INSTALL_AST=false\n"
        printf "WORKSPACE_INSTALL_DOCKER_CLIENT=true\n"
        printf "WORKSPACE_INSTALL_IMAGEMAGICK=true\n"
        printf "WORKSPACE_INSTALL_LDAP=true\n"
        printf "WORKSPACE_INSTALL_PCOV=true\n"
        printf "WORKSPACE_INSTALL_SOAP=true\n"
        printf "WORKSPACE_INSTALL_SSHPASS=true\n"
        printf "WORKSPACE_INSTALL_WORKSPACE_SSH=true\n"
        printf "WORKSPACE_INSTALL_PHPREDIS=true\n"
        printf "WORKSPACE_INSTALL_PG_CLIENT=true\n"
        printf "PHP_FPM_INSTALL_AST=false\n"
        printf "PHP_FPM_INSTALL_IMAGEMAGICK=true\n"
        printf "PHP_FPM_INSTALL_LDAP=false\n"
        printf "PHP_FPM_INSTALL_PGSQL=true\n"
        printf "PHP_FPM_INSTALL_SSHPASS=true\n"
        printf "PHP_FPM_INSTALL_SOAP=true\n"
        printf "PHP_FPM_INSTALL_PHPREDIS=true\n"
        printf "POSTGRES_CLIENT_VERSION=16\n"
        printf "PHP_VERSION=%s\n" "8.2"
        printf "DEFAULT_SERVICES=\"%s\"\n" "${DEFAULT_SERVICES:-nginx redis}"
        printf "PHP_SERVICES=\"%s\"\n" "${PHP_SERVICES:-workspace php-fpm}"
    } >"${LARAKIT_HOME}"/configs/environment
}

imageVersionExists() {
    version=$1

    source "${LARAKIT_HOME}"/configs/environment

    nServices=0
    nImages=0
    for service in $PHP_SERVICES; do
        nServices=$((nServices + 1))
        image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "$service" | grep "$version")
        [ -n "${image}" ] && {
            nImages=$((nImages + 1))
        }
    done

    [ $nImages -eq $nServices ]
}

imageUntagVersion() {
    version=$1

    source "${LARAKIT_HOME}"/configs/environment

    for service in $PHP_SERVICES; do
        image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "$service" | grep "$version")
        [ -n "$image" ] && docker rmi "$image"
    done
}

imageTagVersion() {
    sourceTag=$1
    newTag=$2

    source "${LARAKIT_HOME}"/configs/environment

    for service in ${PHP_SERVICES}; do
        image=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep "${service}" | grep "${sourceTag}")
        newImage=$(echo "${image}" | cut -d: -f1)
        [ -n "${image}" ] && docker tag "${image}" "${newImage}":"${newTag}"
    done
}

buildPhpVersion() {
    newVersion=$1

    updateEnvironment "$newVersion"

    source "${LARAKIT_HOME}"/configs/environment

    for line in $(cat "${LARAKIT_HOME}"/configs/environment); do
        [[ "$line" != *=* ]] && continue
        [[ "$line" == *SERVICES=* ]] && continue

        variable=$(echo $line | cut -d= -f1)
        [ "$variable" != 'DEFAULT_SERVICES' ] && [ "$variable" != 'PHP_SERVICES' ] && export $variable
    done

    export DEFAULT_SERVICES PHP_SERVICES

    [[ "$PHP_SERVICES" == *workspace* ]] && updateWorkspace
    [[ "$PHP_SERVICES" == *php-fpm* ]] && updatePhpFpm

    docker compose ${COMPOSE_CONFIGS} build ${PHP_SERVICES}
}

changePhpVersion() {
    newVersion=$1

    case "${newVersion}" in
    5.6 | 7.2 | 7.3 | 7.4 | 8.0 | 8.1 | 8.2) ;;

    *)
        printf "Invalid PHP version!  Use of one 7.2, 7.3, 7.4, 8.0, 8.1 or 5.6 (if desperate)\n"
        exit
        ;;
    esac

    cwd=$(pwd)
    cd "${LARADOCK_HOME}"

    stackRunning && {
        docker compose ${COMPOSE_CONFIGS} down
    }

    imageVersionExists latest && imageUntagVersion latest

    if imageVersionExists "$newVersion"; then
        imageTagVersion "$newVersion" latest
    else
        buildPhpVersion "$newVersion"
        imageTagVersion latest "$newVersion"
    fi

    cd "${cwd}"
}

copyNginxTemplates() {
    cp "${LARAKIT_HOME}"/templates/nginx.template.conf "${PROJECTDIR}"/nginx.template.conf
    cp "${LARAKIT_HOME}"/templates/nginxconfig "${PROJECTDIR}"/nginxconfig
    chmod u+x "${PROJECTDIR}"/nginxconfig

    printf "nginx.template.conf created\n"
    printf "nginxconfig created\n\n"
    printf "Run ./nginxconfig to enable your project for nginx.\n"
}

nginxCommand() {
    subCommand=$1
    shift

    case "${subCommand}" in
    install)
        copyNginxTemplates
        ;;

    *)
        printf "\nUnknown larakit nginx command: %s\n" "${subCommand}"
        ;;
    esac
}

checkDependencies() {
    path=$(which brew)
    [ $? -ne 0 ] && {
        printf "\nUnable to find brew command!  Make sure Homebrew (https://brew.sh) is installed!\n"
        exit
    }

    path=$(which dnsmasq)
    [ $? -ne 0 ] && {
        printf "\ndnsmasq is not installed!  Follow Larakit Instructions.md to complete installation!\n"
        exit
    }

    which -s yq
    [ $? -ne 0 ] && {
        printf "\nInstalling dependencies 'yq'...\n"
        brew install yq
        [ $? -ne 0 ] && {
            printf "\nInstallation failed!  Run: 'brew install yq' to resolve issues.\n"
            exit
        }
    }

    [ ! -f "$COMPOSE_ALIASES" ] && {
        touch "$COMPOSE_ALIASES"
        aliases="[]" yq e -iP '.services.nginx.networks.backend.aliases = env(aliases)' "$COMPOSE_ALIASES" 2>/dev/null
    }

    [ ! -f "${LARAKIT_HOME}/configs/environment" ] && resetEnvironment
}

loadProjectHostname() {
    VHOST_NAME=''

    [ -f .env ] && {
        source .env

        [ "$VHOST_NAME" = '' -a "$APP_URL" != '' ] && {
            HOSTNAME=$(echo $APP_URL | awk -F/ '{print $3}')
            TLD=$(echo $HOSTNAME | awk -F. '{print $(NF)}')

            [ "$TLD" != '' ] && {
                [ "$TLD" = 'lo' -o "$TLD" = 'test' ] && {
                    VHOST_NAME=$HOSTNAME
                }
            }
        }
    }

    echo $VHOST_NAME
}

loadAllProjectHostnames() {
    projecthosts=''
    cwd=$(pwd)

    for file in $(find "$SITESDIR" -type f -name .env); do
        [[ $file == *"larakit"* ]] && {
            continue
        }

        cd $(dirname "$file")

        hostname=$(loadProjectHostname)
        [ -n "$hostname" ] && {
            projecthosts="$projecthosts $hostname"
        }
    done

    cd "$cwd"
    echo $projecthosts
}

getNginxAliases() {
    aliases=$(yq e '.services.nginx.networks.backend.aliases[]' "$COMPOSE_ALIASES")
    [ "$aliases" = 'null' ] && {
        aliases=''
    }

    echo $aliases
}

registerHostnames() {
    [ $# -eq 0 ] && {
        return
    }

    aliases=$(getNginxAliases)

    aliases=$(echo \[$aliases\] | tr "\n " ',')
    while [ $# -gt 0 ]; do
        newhost=$1
        aliases=$(echo $aliases | newname=$1 yq e '. += env(newname)' - 2>/dev/null)
        shift
    done
    aliases=$(echo $aliases | yq e 'unique' - | sort)

    errors=$(aliases=$aliases yq e -iP '.services.nginx.networks.backend.aliases = env(aliases)' "$COMPOSE_ALIASES")
}

deregisterHostnames() {
    [ $# -eq 0 ] && {
        return
    }

    aliases=$(getNginxAliases)
    [ "$aliases" = 'null' ] && {
        # nothing to do
        return
    }

    while [ $# -gt 0 ]; do
        hostname=$1
        aliases=$(echo $aliases | sed "s/$hostname//")
        shift
    done
    aliases=$(echo $aliases | tr "\n " ',')
    aliases=$(echo \[$aliases\] | yq e 'unique' - 2>/dev/null)

    [ "$aliases" = '' ] && {
        aliases='[]'
    }

    errors=$(newaliases="$aliases" yq e -iP '.services.nginx.networks.backend.aliases = env(newaliases)' "$COMPOSE_ALIASES")
}

reset() {
    cwd=$(pwd)

    cd "${LARADOCK_HOME}"
    docker compose ${COMPOSE_CONFIGS} down

    images=$(docker images --format '{{.Repository}}:{{.Tag}}' | grep laradock)
    [ -n "$images" ] && docker rmi $images

    resetEnvironment

    rm -f "${COMPOSE_ALIASES}"
    touch "$COMPOSE_ALIASES"
    aliases="[]" yq e -iP '.services.nginx.networks.backend.aliases = env(aliases)' "$COMPOSE_ALIASES" 2>/dev/null
}

checkDependencies

# load environment overrides
[ ! -f "${LARAKIT_HOME}"/configs/environment ] && {
    updateEnvironment
}
source "${LARAKIT_HOME}"/configs/environment

export APP_CODE_PATH_HOST PHP_VERSION

currentworkingDir=$(pwd)
command=$1
shift

case "${command}" in
help)
    usage
    ;;

laradock)
    laradockCommand $*
    ;;

env)
    [ "$1" = "reset" ] && resetEnvironment
    showEnvironment
    ;;

exec)
    execService $*
    ;;

run)
    runService workspace $*
    ;;

up)
    loadSshKeys
    cd "${LARADOCK_HOME}"
    SERVICES="$@"
    [ -z "${SERVICES}" ] && {
        SERVICES="${DEFAULT_SERVICES}"
    }
    docker compose ${COMPOSE_CONFIGS} up -d $SERVICES
    ;;

switch)
    changePhpVersion $*
    ;;

nginx)
    nginxCommand $*
    ;;

register)
    case $# in
    0)
        hostnames=$(loadProjectHostname)
        ;;
    *)
        hostnames="$*"
        [ "$hostnames" = 'all' ] && {
            hostnames=$(loadAllProjectHostnames)
        }
        ;;
    esac
    [ -n "$hostnames" ] && {
        registerHostnames $hostnames
    }
    ;;

deregister)
    case $# in
    0)
        hostnames=$(loadProjectHostname)
        ;;
    *)
        hostnames="$*"
        [ "$hostnames" = 'all' ] && {
            hostnames=$(loadAllProjectHostnames)
        }
        ;;
    esac
    [ -n "$hostnames" ] && {
        deregisterHostnames $hostnames
    }
    ;;

reset)
    reset
    ;;

*)
    cd "${LARADOCK_HOME}"
    docker compose ${COMPOSE_CONFIGS} $command $*
    ;;
esac

cd "${currentworkingDir}"
